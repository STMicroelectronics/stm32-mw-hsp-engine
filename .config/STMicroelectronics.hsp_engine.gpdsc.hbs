<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="0.0.1" date="2025-07-17">
      - First GPDSC HSP Engine Model Release
    </release>
  </releases>
  <conditions>
    {{~assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="MX HSP Engine needed components")}}
    {{{@root.conditions}}}

    <!-- CubeMX2 code generation condition -->
    <condition id="MX HSP Engine needed components">
      <description>Mandatory files to include in code generation of HSP Engine Middleware</description>
      <require Cclass="Utility" Cgroup="HSP Engine" Csub="Core"/>
      <require Cclass="Utility" Cgroup="HSP Engine" Csub="Interfaces"/>
      {{#unless (eq (@root.EnvVarAPI.getVariableValue 'HSP_ENGINE_USE_DSP_LIB') undefined)}}
      <require Cclass="Utility" Cgroup="HSP Engine" Csub="DSP"/>
      {{/unless}}
      {{#unless (eq (@root.EnvVarAPI.getVariableValue 'HSP_ENGINE_USE_CNN_LIB') undefined)}}
      <require Cclass="Utility" Cgroup="HSP Engine" Csub="CNN"/>
      {{/unless}}
      {{#unless (eq (@root.EnvVarAPI.getVariableValue 'HSP_ENGINE_USE_SEQUENCER') undefined)}}
      <require Cclass="Utility" Cgroup="HSP Engine" Csub="Processing List"/>
      {{/unless}}
    </condition> 
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="HSP Engine"'))}}
        {{~assign "hsp_engine_Filter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "HSP Engine"}')~}}
        {{~assign 'hsp_eng_context' (@root.SWConfigurationAPI.getInstancesConfiguration @root.hsp_engine_Filter)~}}
        {{~assign 'hsp_instance' @root.hsp_eng_context.[0].settings.parameters.interface.resources_allocation.select_the_hsp_instance.selection~}}
        {{~assign 'hsp_ip_desc' (@root.peripheralsResourceManagerAPI.getHardwareIpDescription @root.hsp_instance)~}}
        {{#if (gte @root.hsp_ip_desc.peripheralVersionNum 1.1)}}
        <Pre_Include_Global_h>
          #define __HSP_DMA__
        </Pre_Include_Global_h>
        {{/if}}
      {{/if}}
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>
